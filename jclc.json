{
  "name": "JCLC",
  "description": "Journal of Communication, Language and Culture manuscript template profile",
  "required_sections": [
    "abstract",
    "keywords",
    "introduction",
    "literature review",
    "methods",
    "results",
    "discussion",
    "conclusion",
    "references"
  ],
  "heading_patterns": [
    "introduction",
    "literature review",
    "methods",
    "results",
    "discussion",
    "conclusion",
    "acknowledgement",
    "conflict of interest",
    "author contribution statement",
    "funding",
    "ethics statement",
    "artificial intelligence use declaration",
    "data access statement",
    "author biography",
    "references",
    "appendix",
    "authors contribution statement",
    "authors biographies",
    "authors biography",
    "author biographies"
  ],
  "required_declarations": [
    "acknowledgement",
    "funding",
    "conflict_of_interest",
    "author_contribution",
    "ethics_statement",
    "ai_declaration",
    "data_access_statement",
    "author_biography"
  ],
  "classification_patterns": {
    "journal_header": [
      "journal\\s+of\\s+communication",
      "language\\s+and\\s+culture"
    ],
    "caption": [
      "^(figure|fig\\.?|table)\\s*\\d+"
    ],
    "reference": [
      "https?://doi\\.org",
      "^(?!.*\\bet al\\.\\s*\\()(?:[^(),]{1,100}?,[^()]{0,100}?[.,]|[^(),]{1,80}?\\.)\\s*\\(\\s*(?:\\d{4}[a-z]?|n\\.d\\.)(?:,\\s*[^)]{1,20})?\\)\\s*\\.\\s+\\S"
    ],
    "author_info": [
      "orcid",
      "corresponding\\s+author",
      "university|universiti|faculty|department|school|college|institute"
    ]
  },
  "rule_weights": {
    "margins": 10,
    "title": 15,
    "body_text": 20,
    "headings": 10,
    "structure": 15,
    "tables": 5,
    "figures": 5,
    "references": 10,
    "line_spacing": 5,
    "other": 5
  },
  "fallback_defaults": {
    "font_name": "Times New Roman",
    "body_font_size": 11,
    "abstract_font_size": 11,
    "caption_font_size": 11,
    "reference_font_size": 11,
    "page_size": "A4"
  },
  "rules": {
    "author_role_terms": {
      "affiliation": [
        "address",
        "academy",
        "bhd",
        "campus",
        "centre",
        "center",
        "clinical informatics unit",
        "company",
        "corporation",
        "department",
        "faculty",
        "gmbh",
        "hospital",
        "inc",
        "institute",
        "jalan",
        "laboratory",
        "limited",
        "llc",
        "ltd",
        "medical centre",
        "medical center",
        "pte ltd",
        "research centre",
        "research center",
        "school",
        "sdn bhd",
        "street",
        "systems",
        "technologies",
        "university",
        "universiti"
      ]
    },
    "margins": {
      "left": 1,
      "right": 1,
      "top": 1,
      "bottom": 1
    },
    "journal_header": {
      "font_name": "Book Antiqua",
      "font_size": 24,
      "bold": true,
      "alignment": "CENTER"
    },
    "title": {
      "font_name": "Times New Roman",
      "font_size": 14,
      "bold": true,
      "alignment": "CENTER",
      "space_before": 0,
      "space_after": 8,
      "line_spacing": 1.0
    },
    "author": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true,
      "alignment": "CENTER"
    },
    "affiliation": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "bold": false,
      "alignment": "CENTER"
    },
    "corresponding_author": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "bold": false,
      "italic": false,
      "alignment": "CENTER",
      "email_required": true,
      "orcid_required": true
    },
    "abstract": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "max_words": 300
    },
    "abstract_heading": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true,
      "all_caps": true,
      "alignment": "LEFT"
    },
    "keywords": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "min_count": 5,
      "bold": false,
      "italic": false,
      "alignment": "JUSTIFY"
    },
    "keywords_heading": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true,
      "all_caps": false,
      "alignment": "LEFT"
    },
    "heading": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true,
      "italic": false,
      "all_caps": false,
      "alignment": "JUSTIFY",
      "space_before": 0,
      "space_after": 8,
      "line_spacing": 1.0
    },
    "subheading": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true,
      "italic": true,
      "alignment": "JUSTIFY",
      "space_before": 0,
      "space_after": 8,
      "line_spacing": 1.0
    },
    "body": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "line_spacing": 1.0,
      "bold": false,
      "space_after": 8,
      "alignment": "JUSTIFY",
      "space_before": 0
    },
    "caption": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true,
      "italic": false,
      "space_before": 0,
      "space_after": 8,
      "line_spacing": 1.0,
      "alignment": "CENTER"
    },
    "table_content": {
      "font_name": "Times New Roman",
      "font_size": 11
    },
    "reference": {
      "font_name": "Times New Roman",
      "font_size": 8,
      "bold": false,
      "alignment": "JUSTIFY",
      "line_spacing": 1.0,
      "space_after": 8,
      "hanging_indent": 0.5,
      "style": "APA7",
      "publication_italic_required": true,
      "doi_required": true,
      "space_before": 0
    },
    "reference_heading": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true
    },
    "layout": {
      "columns": 1,
      "page_size": "A4",
      "orientation": "PORTRAIT"
    },
    "acknowledgement": {
      "required": true
    },
    "conflict_of_interest": {
      "required": true
    },
    "author_contribution": {
      "required": true
    },
    "funding": {
      "required": true
    },
    "ethics_statement": {
      "required": true
    },
    "ai_declaration": {
      "required": true
    },
    "data_access_statement": {
      "required": true
    },
    "author_biography": {
      "required": true
    },
    "appendix": {
      "required": false
    }
  }
}